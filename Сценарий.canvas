{
	"nodes":[
		{"id":"75144168daa12580","x":-92,"y":0,"width":250,"height":80,"type":"text","text":"игрок выходит из лифта в пустой холл"},
		{"id":"66658af7c08fe66a","type":"text","text":"Игрок появляется в едущем наверх лифте","x":-330,"y":-340,"width":250,"height":60},
		{"id":"32486aa100ac26f5","x":-330,"y":-200,"width":250,"height":60,"type":"text","text":"начальник из динамика просит пройти в кабинет"},
		{"id":"c63cda3e1c400ff8","x":-300,"y":240,"width":250,"height":132,"type":"text","text":"сбоку в углу есть вытяжка\nк ней можно подняться поставив несколько столов друг на друга"},
		{"id":"aa2cd13355ff3b9b","x":158,"y":180,"width":250,"height":60,"type":"text","text":"игрок проходит хол в коридор на перекресток"},
		{"id":"2ddff56295cb671e","x":158,"y":312,"width":250,"height":60,"type":"text","text":"голос из динамика просит идти влево к лестнице"},
		{"id":"3e61c59c23cac88a","x":-700,"y":0,"width":250,"height":100,"type":"text","text":"игрок нажимает кнопку в лифте и спускается вниз на подземную парковку"},
		{"id":"ff1aa73c58b877cd","x":-320,"y":600,"width":250,"height":60,"type":"text","text":"чтобы открыть её нужен лом"},
		{"id":"a5a9d617fe8b58b6","x":283,"y":-80,"width":250,"height":160,"type":"text","text":"в холе находится несколько камер которые следят за игроком\n\nпод камерами есть непонятное устройство"},
		{"id":"8d5b8bcbaf04e5a6","x":640,"y":-30,"width":250,"height":60,"type":"text","text":"это устройство атакует электрошокером"},
		{"id":"c8978fff560f4c0a","x":-380,"y":800,"width":250,"height":80,"type":"text","text":"игрок подходит с ломом к люку вентиляции и вскрывает его"},
		{"id":"3065cdcec57ed18b","x":100,"y":465,"width":250,"height":70,"type":"text","text":"игрок поворачивает направо в темный коридор"},
		{"id":"97dcf16d69f46be4","x":100,"y":600,"width":250,"height":60,"type":"text","text":"там он видит дверь в подсобку"},
		{"id":"a2f771ea122569d1","x":740,"y":490,"width":250,"height":60,"type":"text","text":"игрок поворачивает налево и идет к лестнице"},
		{"id":"61066dcbbfcadcb9","x":440,"y":813,"width":250,"height":80,"type":"text","text":"внутри он находит множество предметов, среди которых есть тяжелый лом"},
		{"id":"b4a070c6c4453e9b","x":-25,"y":800,"width":250,"height":106,"type":"text","text":"если игрок идет попадается под камеры с ломом, его атакуют камеры"},
		{"id":"54606ae5d7082342","x":283,"y":823,"width":118,"height":60,"type":"text","text":"лом"},
		{"id":"763d3116fdb94f1c","x":388,"y":1000,"width":104,"height":60,"type":"text","text":"ведро"},
		{"id":"5c66b9c27681d83c","x":1200,"y":530,"width":250,"height":100,"type":"text","text":"по пути к лестнице, возле закрытой двери лежит карточка"}
	],
