{
	"nodes":[
		{"id":"75144168daa12580","type":"text","text":"игрок выходит из лифта в пустой холл","x":-92,"y":0,"width":250,"height":80,"color":"1"},
		{"id":"66658af7c08fe66a","type":"text","text":"Игрок появляется в едущем наверх лифте","x":-330,"y":-340,"width":250,"height":60,"color":"1"},
		{"id":"32486aa100ac26f5","type":"text","text":"голос из динамика просит пройти в кабинет N123","x":-330,"y":-200,"width":250,"height":80,"color":"1"},
		{"id":"c63cda3e1c400ff8","type":"text","text":"сбоку в углу есть вытяжка\nк ней можно подняться поставив несколько столов друг на друга","x":-300,"y":240,"width":250,"height":132,"color":"5"},
		{"id":"aa2cd13355ff3b9b","type":"text","text":"игрок проходит хол в коридор на перекресток","x":158,"y":180,"width":250,"height":60,"color":"1"},
		{"id":"2ddff56295cb671e","type":"text","text":"голос из динамика просит идти влево и по прямой","x":158,"y":312,"width":250,"height":60,"color":"1"},
		{"id":"3e61c59c23cac88a","type":"text","text":"игрок нажимает кнопку в лифте и спускается вниз на подземную парковку","x":-700,"y":0,"width":250,"height":100,"color":"5"},
		{"id":"ff1aa73c58b877cd","type":"text","text":"чтобы открыть её нужен лом","x":-320,"y":600,"width":250,"height":60},
		{"id":"a5a9d617fe8b58b6","type":"text","text":"в холе находится несколько камер которые следят за игроком\n\nпод камерами есть непонятное устройство","x":283,"y":-80,"width":250,"height":160},
		{"id":"8d5b8bcbaf04e5a6","type":"text","text":"это устройство атакует электрошокером","x":640,"y":-30,"width":250,"height":60},
		{"id":"c8978fff560f4c0a","type":"text","text":"игрок подходит с ломом к люку вентиляции и вскрывает его","x":-380,"y":800,"width":250,"height":80},
		{"id":"3065cdcec57ed18b","type":"text","text":"игрок поворачивает направо в темный коридор","x":100,"y":465,"width":250,"height":70,"color":"5"},
		{"id":"97dcf16d69f46be4","type":"text","text":"там он видит дверь в подсобку","x":100,"y":600,"width":250,"height":60},
		{"id":"61066dcbbfcadcb9","type":"text","text":"внутри он находит множество предметов","x":440,"y":813,"width":250,"height":80},
		{"id":"b4a070c6c4453e9b","type":"text","text":"если игрок идет попадается под камеры с ломом, его атакуют камеры","x":-25,"y":800,"width":250,"height":106,"color":"#000000"},
		{"id":"54606ae5d7082342","type":"text","text":"лом","x":283,"y":823,"width":118,"height":60},
		{"id":"5d1482b6fc0ebc52","x":-92,"y":1060,"width":250,"height":101,"type":"text","text":"на ресепшене можно брать ручки/карандаши\nих можно кинуть в камеру и она сломается"},
		{"id":"201b5c7a6e4860ed","x":-825,"y":475,"width":250,"height":60,"type":"text","text":"на парковке стоит грустная девочка"},
		{"id":"fd2b226ccdcd752b","x":-840,"y":766,"width":250,"height":114,"type":"text","text":"если дать ей карандаши, она начнет рисовать и перестанет грустить"},
		{"id":"a2f771ea122569d1","type":"text","text":"игрок поворачивает налево и идет в сторону лестницы к кабинету N123","x":690,"y":465,"width":250,"height":95,"color":"1"},
		{"id":"5c66b9c27681d83c","type":"text","text":"по пути к лестнице, возле закрытой двери лежит карточка","x":1020,"y":580,"width":250,"height":100,"color":"5"},
		{"id":"71514911c012eb6f","x":1340,"y":680,"width":250,"height":60,"type":"text","text":"она открывает доступ к серверной"},
		{"id":"09f3963462df1415","x":1340,"y":1081,"width":250,"height":60,"type":"text","text":"в серверной можно отключить камеры"},
		{"id":"0eab2eb863326672","x":-686,"y":1157,"width":250,"height":83,"type":"text","text":"тут дальше концовка с люком, хз че, надо придумать"},
		{"id":"3101861e03691986","x":-686,"y":1300,"width":250,"height":151,"type":"text","text":"может игрок ползет и попадает к начальнику, подслушивает его разговор об ужасных планах и конец?"},
		{"id":"99e42699a97b88ec","x":-1040,"y":334,"width":250,"height":60,"type":"text","text":"тут надо еще что то придумать"},
		{"id":"e1d8e7cde3017166","x":440,"y":1199,"width":250,"height":111,"color":"1","type":"text","text":"игрок заходит в испытательный кабинет N123"},
		{"id":"4c986b445b325b4a","x":895,"y":342,"width":250,"height":110,"type":"text","text":"справой стороны лестница наверх, и немного впереди одинокая комната"},
		{"id":"d9ce24387c7b8d0a","x":440,"y":1391,"width":250,"height":109,"color":"1","type":"text","text":"Внутри перед собой он видит кнопку и открытую дверь"},
		{"id":"95978615d9cf40ef","x":440,"y":1560,"width":250,"height":60,"color":"1","type":"text","text":"из динамиков просят нажать её"},
		{"id":"7bdb60bc7c13f52f","x":440,"y":1750,"width":250,"height":120,"color":"1","type":"text","text":"когда игрок нажимает на кнопку, дверь закрывается, а голос говорит проходить дальше"},
		{"id":"ab0f6de97d1b4e98","x":112,"y":1780,"width":250,"height":60,"color":"5","type":"text","text":"игрок проходит дальше через открытую дверь"},
		{"id":"cfd09c73414d2af6","x":815,"y":2000,"width":250,"height":85,"color":"3","type":"text","text":"игрок подходит к двери, камера поворачивается за ним"},
		{"id":"c4a1eb6357cc294c","x":869,"y":2144,"width":250,"height":136,"color":"3","type":"text","text":"голос из динамика замечает что дверь закрыта, и просит нажать кнопку еще раз"},
		{"id":"6db83aebe80fbc53","x":526,"y":2320,"width":250,"height":98,"color":"1","type":"text","text":"игрок нажимает кнопку еще раз и дверь открывается"},
		{"id":"d4edc1afd6ca66c4","x":278,"y":2501,"width":250,"height":99,"color":"2","type":"text","text":"спустя пару секунд голос спрашивает:\nНу и? Чего стоим?"},
		{"id":"aadcbed2b53ba870","x":-45,"y":2224,"width":250,"height":277,"color":"2","type":"text","text":"если игрок многократно нажимает кнопку, дверь ломается и остается открытой, а голос злиться:\n\"И-ДИ-ОТ, вы допустили потерю дорогостоящего обмундирования, его стоимость будет вычтена из вашего жалованья"},
		{"id":"ffe42f6c756eeca1","x":-45,"y":1940,"width":250,"height":120,"color":"2","type":"text","text":"спустя 5 секунд голос раздраженно спрашивает почему ты все еще не в следующей комнате"},
		{"id":"99939d296d9feb4b","x":655,"y":2577,"width":250,"height":60,"color":"1","type":"text","text":"игрок проходит в следующую комнату"},
		{"id":"1610a1fff5d915c6","x":655,"y":2720,"width":250,"height":60,"color":"1","type":"text","text":"игрок видит перед собой 2 двери"},
		{"id":"403666b829126203","x":655,"y":2840,"width":250,"height":132,"color":"1","type":"text","text":"голос из динамиков указывает:\n\"Тут можете не задерживаться, проходите в следующую комнату\""},
		{"id":"0c5b8b95d5641377","x":655,"y":3040,"width":250,"height":90,"color":"1","type":"text","text":"игрок подходит к двум дверям и не понимает в какую идти"},
		{"id":"a960d44628c9a998","x":655,"y":3160,"width":250,"height":112,"color":"1","type":"text","text":"По камерам контроллер замечает две двери вместо ожидаемого одного прохода"},
		{"id":"b101233ea61636b2","x":611,"y":3360,"width":339,"height":149,"color":"1","type":"text","text":"\"Странно...\", - недоумевает он. - \"По навиг... кхм кхм\" - слышен кашель и бубнешь.\nИ спустя пару мгновений - \"Так! Пройдите в левую дверь\""},
		{"id":"5a1e802bae8130ac","x":533,"y":3594,"width":250,"height":60,"color":"1","type":"text","text":"игрок проходит в левую дверь"},
		{"id":"9c750e4570b8edfb","x":834,"y":3592,"width":250,"height":62,"color":"3","type":"text","text":"игрок проходит в правую дверь"},
		{"id":"cdcce0aeed78205c","x":700,"y":3800,"width":250,"height":60,"color":"1","type":"text","text":"обе двери ведут в одну и ту же комнату"},
		{"id":"254c0239e96c37af","x":-770,"y":-242,"width":250,"height":60,"color":"6","type":"text","text":"но это голос контроллера"},
		{"id":"46f52ac756ee63d1","x":-715,"y":-388,"width":250,"height":97,"color":"6","type":"text","text":"тут теперь не голос начальника, игрок не знает кому принадлежит голос"},
		{"id":"f463adec84cd1987","x":1240,"y":3519,"width":250,"height":146,"color":"6","type":"text","text":"ЗАМЕТКА: тут желтый, так как это действие должно увеличить шкалу раздражительности у контроллера"},
		{"id":"05e3d9ace554dea7","x":1560,"y":3527,"width":250,"height":131,"color":"6","type":"text","text":"пока я не знаю что можно будет сделать с этой механикой, но потенциально будет влиять на реплики"},
		{"id":"763d3116fdb94f1c","type":"text","text":"ведро","x":1120,"y":840,"width":104,"height":60},
		{"id":"8ddc788fdf3983f9","x":995,"y":1018,"width":250,"height":93,"type":"text","text":"можно будет набрать воды и вылить на начальника (КОНЕЦ)"},
		{"id":"a402178da3dccbb9","x":870,"y":1225,"width":250,"height":55,"type":"text","text":"игрок поднимается по лестнице"},
		{"id":"d4911790d9edb43c","x":870,"y":1341,"width":250,"height":105,"type":"text","text":"на следующем этаже проход к лестнице контролирует камера"},
		{"id":"ec1920719c03d822","x":1215,"y":1530,"width":250,"height":60,"type":"text","text":"игрок проходит дальше"},
		{"id":"46622775eb7a6dd0","x":870,"y":1560,"width":250,"height":60,"color":"#050505","type":"text","text":"камера замечает игрока и вырубает его"},
		{"id":"ba9ce0179fc54102","x":-505,"y":2164,"width":250,"height":60,"type":"text","text":"гантеля"},
		{"id":"a7d53b8f8ca3973e","x":700,"y":3957,"width":250,"height":123,"color":"1","type":"text","text":"в новой комнате игрок видит перед собой куб, напольную кнопку и закрытую дверь"},
		{"id":"e3cc6e0e154be99e","x":700,"y":4140,"width":250,"height":97,"color":"1","type":"text","text":"контроллер усмехается: \"Ну тут и ребенку понятно что делать\""},
		{"id":"301340c7573b1e68","x":666,"y":4378,"width":250,"height":60,"color":"1","type":"text","text":"игрок ставит куб на кнопку, дверь открывается"},
		{"id":"428e01c97e2cdc6e","x":666,"y":4520,"width":250,"height":98,"color":"1","type":"text","text":"контроллер говорит: \"Отлично, пройдите в следующую комнату\""},
		{"id":"bf807169fa6cc33a","x":855,"y":4700,"width":250,"height":102,"type":"text","text":"игрок убирает куб с кнопки, но дверь не закрывается"},
		{"id":"6c71afbbebb6a72e","x":980,"y":4920,"width":220,"height":80,"color":"5","type":"text","text":"игрок тащит куб в следующую комнату"},
		{"id":"406c2d7e25ad9818","x":1290,"y":4700,"width":250,"height":160,"color":"2","type":"text","text":"контроллер удивляется - \"О как, понятненько. Вы проходите, это штатная ситуация, проходите дальше\""},
		{"id":"2d9592f42e2ad91e","x":408,"y":4835,"width":250,"height":51,"color":"1","type":"text","text":"игрок проходит дальше"},
		{"id":"5f3b30534b307a6a","x":-420,"y":4288,"width":250,"height":180,"type":"text","text":"ОСНОВНАЯ КОНЦОВКА:\nнашальника говорит что ты не нужен, так как тебя заменяют нейросетями, и поэтому ты свободен идти на все четыре стороны"},
		{"id":"89e937ec4a797ded","x":1306,"y":4975,"width":250,"height":125,"color":"6","type":"text","text":"вот эта ветка должна привести к концовки где игрок приходит к начальнику"},
		{"id":"7467f3d386d7c80f","x":1530,"y":4983,"width":250,"height":60,"type":"text","text":""},
		{"id":"a63ad2251acaa496","x":1590,"y":1530,"width":250,"height":60,"color":"6","type":"text","text":"эта ветка ведет к начальнику"},
		{"id":"0530864853efe1db","x":-550,"y":-852,"width":250,"height":178,"color":"6","type":"text","text":"игрок следует всем приказам контроллера и в конце узнает что он больше не нужен и его выпинывают с работы"},
		{"id":"c586e9cec5fcc7e9","x":-770,"y":-599,"width":250,"height":60,"color":"#000000","type":"text","text":"BAD ENDING"},
		{"id":"fef911eb5fc661cc","x":-175,"y":-852,"width":250,"height":132,"color":"6","type":"text","text":"игрок попадает к начальнику, дает ему пизды, после чего его сажают в тюрьму"},
		{"id":"78cd85b14de19c17","x":-300,"y":-599,"width":250,"height":111,"color":"6","type":"text","text":"если игрок не дает начальнику пизды, его выгоняют с работы"},
		{"id":"7eecb358171f86de","x":20,"y":-488,"width":170,"height":60,"color":"#000000","type":"text","text":"LIBERTY ENDING"},
		{"id":"ef456b96e87dc3d7","x":140,"y":-844,"width":250,"height":124,"color":"6","type":"text","text":"попасть на эту концовку можно несколькими способами, так сказать с разных \"сторон\""},
		{"id":"74d2b15981cb817a","x":640,"y":-370,"width":250,"height":60,"color":"#000000","type":"text","text":"GOOD ENDING"},
		{"id":"08982c62da3d7fa5","x":640,"y":-1276,"width":250,"height":788,"color":"6","type":"text","text":"игрок частично проходит комнаты испытаний, но выходит из них\nнаходит диск\nвозвращается на старт\nпопадает в серверную, взламывает её и скачивает от туда видео с его \"ужасной\" эксплуатацией\nпробравшись через вентиляцию к его кабинету начальника записывает его разговор\nспускается с доказательствами на парковку\nтам видит агента фбр рядом с девочкой\nподходит к нему, его узнает девочка которой игрок дал карандаши\nона говорит об этом своему отцу\nи агент фбр выслушивает рассказ игрока и принимает доказательства\n\nв итоге начальник \"пропадает\", а компания разоряется на множестве компенсаций и банкротится"},
		{"id":"b14a77ab01958cbf","x":-230,"y":-1240,"width":250,"height":60,"color":"6","type":"text","text":"я думаю можно сделать примерно такие концовки"}
	],
