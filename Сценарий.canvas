{
	"nodes":[
		{"id":"75144168daa12580","type":"text","text":"игрок выходит из лифта в пустой холл","x":-92,"y":0,"width":250,"height":80,"color":"1"},
		{"id":"66658af7c08fe66a","type":"text","text":"Игрок появляется в едущем наверх лифте","x":-330,"y":-340,"width":250,"height":60,"color":"1"},
		{"id":"32486aa100ac26f5","type":"text","text":"начальник из динамика просит пройти в кабинет N123","x":-330,"y":-200,"width":250,"height":80,"color":"1"},
		{"id":"c63cda3e1c400ff8","type":"text","text":"сбоку в углу есть вытяжка\nк ней можно подняться поставив несколько столов друг на друга","x":-300,"y":240,"width":250,"height":132,"color":"5"},
		{"id":"aa2cd13355ff3b9b","type":"text","text":"игрок проходит хол в коридор на перекресток","x":158,"y":180,"width":250,"height":60,"color":"1"},
		{"id":"2ddff56295cb671e","type":"text","text":"голос из динамика просит идти влево и по прямой","x":158,"y":312,"width":250,"height":60,"color":"1"},
		{"id":"3e61c59c23cac88a","type":"text","text":"игрок нажимает кнопку в лифте и спускается вниз на подземную парковку","x":-700,"y":0,"width":250,"height":100,"color":"5"},
		{"id":"ff1aa73c58b877cd","type":"text","text":"чтобы открыть её нужен лом","x":-320,"y":600,"width":250,"height":60},
		{"id":"a5a9d617fe8b58b6","type":"text","text":"в холе находится несколько камер которые следят за игроком\n\nпод камерами есть непонятное устройство","x":283,"y":-80,"width":250,"height":160},
		{"id":"8d5b8bcbaf04e5a6","type":"text","text":"это устройство атакует электрошокером","x":640,"y":-30,"width":250,"height":60},
		{"id":"c8978fff560f4c0a","type":"text","text":"игрок подходит с ломом к люку вентиляции и вскрывает его","x":-380,"y":800,"width":250,"height":80},
		{"id":"3065cdcec57ed18b","type":"text","text":"игрок поворачивает направо в темный коридор","x":100,"y":465,"width":250,"height":70,"color":"5"},
		{"id":"97dcf16d69f46be4","type":"text","text":"там он видит дверь в подсобку","x":100,"y":600,"width":250,"height":60},
		{"id":"61066dcbbfcadcb9","type":"text","text":"внутри он находит множество предметов, среди которых есть тяжелый лом","x":440,"y":813,"width":250,"height":80},
		{"id":"b4a070c6c4453e9b","type":"text","text":"если игрок идет попадается под камеры с ломом, его атакуют камеры","x":-25,"y":800,"width":250,"height":106},
		{"id":"54606ae5d7082342","type":"text","text":"лом","x":283,"y":823,"width":118,"height":60},
		{"id":"5d1482b6fc0ebc52","x":-92,"y":1060,"width":250,"height":101,"type":"text","text":"на ресепшене можно брать ручки/карандаши\nих можно кинуть в камеру и она сломается"},
		{"id":"201b5c7a6e4860ed","x":-825,"y":475,"width":250,"height":60,"type":"text","text":"на парковке стоит грустная девочка"},
		{"id":"fd2b226ccdcd752b","x":-840,"y":766,"width":250,"height":114,"type":"text","text":"если дать ей карандаши, она начнет рисовать и перестанет грустить"},
		{"id":"a2f771ea122569d1","type":"text","text":"игрок поворачивает налево и идет в сторону лестницы к кабинету N123","x":690,"y":465,"width":250,"height":95,"color":"1"},
		{"id":"5c66b9c27681d83c","type":"text","text":"по пути к лестнице, возле закрытой двери лежит карточка","x":1020,"y":580,"width":250,"height":100},
		{"id":"71514911c012eb6f","x":1340,"y":680,"width":250,"height":60,"type":"text","text":"она открывает доступ к серверной"},
		{"id":"09f3963462df1415","x":1340,"y":1081,"width":250,"height":60,"type":"text","text":"в серверной можно отключить камеры"},
		{"id":"763d3116fdb94f1c","type":"text","text":"ведро","x":940,"y":846,"width":104,"height":60},
		{"id":"8ddc788fdf3983f9","x":765,"y":988,"width":250,"height":93,"type":"text","text":"можно будет набрать воды и вылить на начальника (КОНЕЦ)"},
		{"id":"0eab2eb863326672","x":-686,"y":1157,"width":250,"height":83,"type":"text","text":"тут дальше концовка с люком, хз че, надо придумать"},
		{"id":"3101861e03691986","x":-686,"y":1300,"width":250,"height":151,"type":"text","text":"может игрок ползет и попадает к начальнику, подслушивает его разговор об ужасных планах и конец?"},
		{"id":"99e42699a97b88ec","x":-1040,"y":334,"width":250,"height":60,"type":"text","text":"тут надо еще что то придумать"},
		{"id":"e1d8e7cde3017166","x":440,"y":1199,"width":250,"height":111,"color":"1","type":"text","text":"игрок заходит в испытательный кабинет N123"},
		{"id":"4c986b445b325b4a","x":895,"y":342,"width":250,"height":110,"type":"text","text":"справой стороны лестница наверх, и немного впереди одинокая комната"},
		{"id":"d9ce24387c7b8d0a","x":440,"y":1391,"width":250,"height":109,"color":"1","type":"text","text":"Внутри перед собой он видит кнопку и открытую дверь"},
		{"id":"95978615d9cf40ef","x":440,"y":1560,"width":250,"height":60,"color":"1","type":"text","text":"из динамиков просят нажать её"},
		{"id":"7bdb60bc7c13f52f","x":440,"y":1750,"width":250,"height":120,"color":"1","type":"text","text":"когда игрок нажимает на кнопку, дверь закрывается, а голос говорит проходить дальше"},
		{"id":"ab0f6de97d1b4e98","x":112,"y":1780,"width":250,"height":60,"color":"5","type":"text","text":"игрок проходит дальше через открытую дверь"},
		{"id":"cfd09c73414d2af6","x":815,"y":2000,"width":250,"height":85,"color":"3","type":"text","text":"игрок подходит к двери, камера поворачивается за ним"},
		{"id":"c4a1eb6357cc294c","x":869,"y":2144,"width":250,"height":136,"color":"3","type":"text","text":"голос из динамика замечает что дверь закрыта, и просит нажать кнопку еще раз"},
		{"id":"6db83aebe80fbc53","x":526,"y":2320,"width":250,"height":98,"color":"1","type":"text","text":"игрок нажимает кнопку еще раз и дверь открывается"},
		{"id":"d4edc1afd6ca66c4","x":278,"y":2501,"width":250,"height":99,"color":"3","type":"text","text":"спустя пару секунд голос спрашивает:\nНу и? Чего стоим?"},
		{"id":"aadcbed2b53ba870","x":-45,"y":2224,"width":250,"height":277,"color":"2","type":"text","text":"если игрок многократно нажимает кнопку, дверь ломается и остается открытой, а голос злиться:\n\"И-ДИ-ОТ, вы допустили потерю дорогостоящего обмундирования, его стоимость будет вычтена из вашего жалованья"},
		{"id":"ffe42f6c756eeca1","x":-45,"y":1940,"width":250,"height":120,"color":"2","type":"text","text":"спустя 5 секунд голос раздраженно спрашивает почему ты все еще не в следующей комнате"},
		{"id":"5f3b30534b307a6a","x":744,"y":3200,"width":250,"height":180,"type":"text","text":"ОСНОВНАЯ КОНЦОВКА:\nнашальника говорит что ты не нужен, так как тебя заменяют нейросетями, и поэтому ты свободен идти на все четыре стороны"},
		{"id":"99939d296d9feb4b","x":655,"y":2577,"width":250,"height":60,"color":"1","type":"text","text":"игрок проходит в следующую комнату"}
	],
